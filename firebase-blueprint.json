{
  "entities": {
    "UserProfile": {
      "collection": "users",
      "fields": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "avatar": { "type": "string" },
        "currency": { "type": "string" },
        "language": { "type": "string" },
        "notificationSettings": { "type": "map" },
        "updatedAt": { "type": "string" }
      }
    },
    "Notification": {
      "collection": "users/{userId}/notifications",
      "fields": {
        "message": { "type": "string" },
        "type": { "type": "string" },
        "domain": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "FamilyMember": {
      "collection": "users/{userId}/familyMembers",
      "fields": {
        "name": { "type": "string" },
        "relation": { "type": "string" },
        "age": { "type": "number" },
        "avatar": { "type": "string" },
        "email": { "type": "string" },
        "inviteStatus": { "type": "string" }
      }
    },
    "Medicine": {
      "collection": "users/{userId}/medicines",
      "fields": {
        "name": { "type": "string" },
        "memberId": { "type": "string" },
        "dosage": { "type": "number" },
        "unit": { "type": "string" },
        "doseQuantity": { "type": "number" },
        "doseForm": { "type": "string" },
        "stock": { "type": "number" },
        "times": { "type": "array" },
        "mealRelation": { "type": "string" },
        "schedule": { "type": "map" },
        "history": { "type": "array" }
      }
    },
    "Appointment": {
      "collection": "users/{userId}/appointments",
      "fields": {
        "memberId": { "type": "string" },
        "doctorName": { "type": "string" },
        "clinicName": { "type": "string" },
        "dateTime": { "type": "string" },
        "purpose": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "Bill": {
      "collection": "users/{userId}/bills",
      "fields": {
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "dueDate": { "type": "string" },
        "paid": { "type": "boolean" },
        "recurrence": { "type": "string" }
      }
    },
    "Task": {
      "collection": "users/{userId}/tasks",
      "fields": {
        "content": { "type": "string" },
        "completed": { "type": "boolean" },
        "listId": { "type": "string" },
        "dueDate": { "type": "string" }
      }
    }
  }
}
