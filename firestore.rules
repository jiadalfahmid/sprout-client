rules_version = '2';

// -----------------------------------------------------------------------------
// Sprout Household-Scoped Security Rules
//
// In Sprout, user domain data (medicines, bills, transactions, tasks, etc.)
// is stored under `users/{userId}/*` where `userId` represents the household ID
// (created by the initial owner whose UID matches this ID).
//
// Shared household data is accessible to any accepted member whose UID is listed
// in `households/{householdId}.members`.
//
// Individual user profile documents (`users/{userId}`) remain strictly private to
// the authenticated user (`request.auth.uid == userId`).
// -----------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    match /test/{docId} {
      allow read: if true;
    }

    function isHouseholdMember(householdId) {
      return request.auth != null &&
        (
          request.auth.uid == householdId ||
          (
            exists(/databases/$(database)/documents/households/$(householdId)) &&
            request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members
          )
        );
    }

    function isHouseholdOwner(householdId) {
      return request.auth != null && request.auth.uid == householdId;
    }

    match /households/{householdId} {
      allow read: if isHouseholdOwner(householdId) || isHouseholdMember(householdId);
      // Only the owner (uid === householdId) can create their own household doc.
      allow create: if isHouseholdOwner(householdId);
      // Only the owner (or Admin SDK) can add members or modify household metadata.
      // Non-owner members may ONLY ever REMOVE their own key (leave), never add one from client.
      allow update: if request.auth != null &&
        exists(/databases/$(database)/documents/households/$(householdId)) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        (
          isHouseholdOwner(householdId) ||
          (
            request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]) &&
            !(request.auth.uid in request.resource.data.members) &&
            request.auth.uid in resource.data.members
          )
        );
      allow delete: if isHouseholdOwner(householdId);
    }

    match /user_household_memberships/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /family_invites/{inviteId} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.inviterUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.inviterUid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.inviterUid == request.auth.uid ||
        (
          resource.data.status == 'pending' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.acceptedByUid == request.auth.uid &&
          (
            !('recipientEmail' in resource.data) ||
            resource.data.recipientEmail == null ||
            resource.data.recipientEmail == '' ||
            request.auth.token.email == resource.data.recipientEmail
          )
        )
      );
      allow delete: if request.auth != null && resource.data.inviterUid == request.auth.uid;
    }

    match /users/{userId} {
      // The user's own profile doc stays strictly private to them.
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // All domain-data subcollections are now household-scoped: readable/
      // writable by any accepted member of the household whose id === userId.
      match /{subcollection}/{docId=**} {
        allow read, write: if (request.auth != null && request.auth.uid == userId) || isHouseholdMember(userId);
      }
    }
  }
}
