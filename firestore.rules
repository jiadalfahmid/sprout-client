rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Connection health check document
    match /test/{docId} {
      allow read: if true;
    }

    // Family invitations collection for linking family circles
    match /family_invites/{inviteId} {
      // Allow single document get so invitee can inspect valid invite details
      allow get: if true;
      // Allow listing invites only when queried by the authenticated inviter
      allow list: if request.auth != null && resource.data.inviterUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.inviterUid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.inviterUid == request.auth.uid || 
        (
          resource.data.status == 'pending' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.acceptedByUid == request.auth.uid &&
          (
            !('recipientEmail' in resource.data) || 
            resource.data.recipientEmail == null || 
            resource.data.recipientEmail == '' || 
            request.auth.token.email == resource.data.recipientEmail
          )
        )
      );
      allow delete: if request.auth != null && resource.data.inviterUid == request.auth.uid;
    }

    // User profiles and all user subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Family members subcollection - strictly scoped to owning user
      match /familyMembers/{memberId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Other subcollections are strictly private to the user
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}


