rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Family invitations collection for linking family circles
    match /family_invites/{inviteId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Family members collection allows reading and updating for invite link acceptance
      match /familyMembers/{memberId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      // Other subcollections are strictly private to the user
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

